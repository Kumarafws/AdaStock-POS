APP_NAME="AdaStock POS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://adastock.your-domain.vercel.app

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Database Configuration (PostgreSQL recommended for production & Vercel)
DB_CONNECTION=pgsql
# If using a direct connection URI (e.g. Neon, Supabase, Railway):
# DB_URL=postgres://username:password@ep-host.region.aws.neon.tech/neondb?sslmode=require
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=adastock_prod
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=prefer

# Session & Cookie Security (Database session is required for serverless Vercel)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Cache & Queue (Database driver required for serverless environment)
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# Serverless Storage Path (Required on read-only hosting like Vercel / AWS Lambda)
APP_STORAGE_PATH=/tmp/storage

# Mail Configuration
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@adastock.local"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
